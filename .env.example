# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
APP_NAME=MyMCPs
VITE_APP_NAME=MyMCPs
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Deno binary for npm-transport MCP sandboxes.
# Optional on a host install when `deno` is already on PATH.
# The Docker image sets DENO_PATH=/usr/local/bin/deno automatically.
# DENO_PATH=/usr/local/bin/deno
