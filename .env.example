# Server
TZ=UTC
PORT=3333
HOST=localhost
# development, production, or test. A server started without it runs as
# production.
APP_ENV=development

# App
LOG_LEVEL=info
# Proxies trusted to forward the caller IP: true, false, or a comma-separated
# list of proxy IPs, CIDR ranges, and the names loopback, linklocal, uniquelocal.
# Behind a reverse proxy on a private network, use loopback,uniquelocal.
TRUST_PROXY=loopback
# Encrypts stored MCP credentials and signs sessions. Left empty, the server
# generates a key on its first start and keeps it in the data directory
# (tmp/app.key). `mymcps generate:key` prints one to set here instead.
APP_KEY=
# Public origin used for gateway URLs, invite links, and OAuth callbacks.
# Set this explicitly to the public HTTPS origin in production.
APP_URL=http://${HOST}:${PORT}

# Where the database, the generated key, MCP sandboxes, and uploads are kept.
# Defaults to tmp under the working directory (/app/tmp in the Docker image).
# DATA_DIR=tmp

# Node.js binary that runs npm-transport MCPs, with its npm beside it.
# Optional on a host install when `node` is already on PATH. Name the binary
# itself, not the launcher of a version manager.
# The Docker image sets NODE_BINARY=/usr/local/bin/node automatically.
# NODE_BINARY=/usr/local/bin/node

# npm-transport MCPs run in a sandbox of the Linux kernel (Landlock and
# seccomp), and do not start where it cannot be enforced. `off` starts them
# without a sandbox, with every right of the server: for development on macOS
# or Windows only.
# NPM_SANDBOX=off

# tailscaled binary that runs the nodes of Tailscale proxies. Optional on a
# host install when `tailscaled` is already on PATH; only needed when you add
# a proxy. The Docker image sets TAILSCALED_BINARY=/usr/local/bin/tailscaled
# automatically.
# TAILSCALED_BINARY=/usr/sbin/tailscaled

# How many Tailscale proxies the instance runs, all teams together (a team has
# at most 5). 0 turns Tailscale proxies off.
# TAILSCALE_MAX_PROXIES=20
