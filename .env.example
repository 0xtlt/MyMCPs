# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
APP_NAME=MyMCPs
VITE_APP_NAME=MyMCPs
LOG_LEVEL=info
# Proxies trusted to forward the caller IP: true, false, or a comma-separated
# list of proxy IPs, CIDR ranges, and the names loopback, linklocal, uniquelocal.
# Behind a reverse proxy on a private network, use loopback,uniquelocal.
TRUST_PROXY=loopback
# Required for `pnpm run dev`; the Docker entrypoint generates and persists
# one automatically when this is left empty.
APP_KEY=
# Public origin used for gateway URLs, invite links, and OAuth callbacks.
# Set this explicitly to the public HTTPS origin in production.
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Deno binary for npm-transport MCP sandboxes.
# Optional on a host install when `deno` is already on PATH.
# The Docker image sets DENO_PATH=/usr/local/bin/deno automatically.
# DENO_PATH=/usr/local/bin/deno
