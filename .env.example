# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
APP_NAME=MyMCPs
VITE_APP_NAME=MyMCPs
LOG_LEVEL=info
# Required for `pnpm run dev`; the Docker entrypoint generates and persists
# one automatically when this is left empty.
APP_KEY=
# Public origin used for redirects and OAuth callbacks in production.
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Deno binary for npm-transport MCP sandboxes.
# Optional on a host install when `deno` is already on PATH.
# The Docker image sets DENO_PATH=/usr/local/bin/deno automatically.
# DENO_PATH=/usr/local/bin/deno