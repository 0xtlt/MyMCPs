# The image is compiled from the Cargo workspace and nothing else, so only
# that enters the build context.
*
!Cargo.toml
!Cargo.lock
!.cargo
!crates

# Left out wherever they are, including under the paths allowed above.

# Secrets & local env
.env
.env.*
**/.env
**/.env.*

# Git / coding-agent state (local settings, worktrees, transcripts)
.git
.claude
.codex
.cursor
**/.git
**/.claude
**/.codex
**/.cursor

# Build output, logs & OS junk
**/target
**/*.log
**/.DS_Store
