<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
    <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title data-inertia>
      MyMCPs
    </title>

    @viteReactRefresh({ nonce: cspNonce })
    @vite(['inertia/app.tsx'], { nonce: cspNonce })
    @inertiaHead()
    @stack('dumper')
  </head>

  <body>
    {{--
      Written out instead of @inertia(), which escapes only "/" in the page data:
      a prop containing "<!--<script" would then swallow the mount element.
      inertiaPageJson() comes from providers/inertia_page_provider.ts.
    --}}
    @if(page.ssrBody)
      {{{ page.ssrBody }}}
    @else
      <script data-page="app" type="application/json">{{{ inertiaPageJson(page) }}}</script>
      <div id="app"></div>
    @end
  </body>

</html>
